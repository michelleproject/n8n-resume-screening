            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "a5e44aeb-ccb6-487f-be9a-1d47c64724dc",
                    "leftValue": "={{ $json.output.verdict }}",
                    "rightValue": "maybe",
